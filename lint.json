{
  "shared_component": "shared",
  "instrumentation_packages": [
          "shared/sim/aver/**",
          "shared/snap/**",
          "shared/jlog/**"
  ],
  "pure_but_indeterministic_packages": [
    "lint/internal/",
    "sloc/internal/**",
    "shared/sync/diode/",
    "shared/sim/aver/",
    "shared/jlog/",
    "shared/snap/"
  ],
  "ignore": [
          "install_golang.sh",
          "nix/**",
          "shared/sim/aver/enforcement_noop*",
          "build.go",
          "home/**",
          "documentation/youtube/**",
          "shared_lua/**",
          "shared/crypto/ecdsa/**",
          "shared/crypto/ed25519/**",
          "shared/crypto/elliptic/**",
          "shared/crypto/rsa/**",
          "shared/crypto/subtle/**",
          "shared/crypto/x509/**"
  ],
  "opt_out_interface_ban": [
          "lint/internal/",
          "shared/backoff/",
          "shared/crypto/prng/",
          "shared/encoding/binary/",
          "shared/encoding/flatjson/",
          "shared/jlog/",
          "shared/sim/aver/**",
          "shared/sim/nbio/",
          "shared/sim/time/",
          "shared/slices/",
          "shared/snap/**",
          "shared/sort/",
          "shared/testify/"
  ],
  "opt_out_recursion_ban": [
          "shared/text/glob/**",
          "shared/go/**"
  ],
  "opt_out_assertion_mandate_packages": [
          "**",
          "!shared/**",
          "shared/vsr/**",
          "shared/testify/**",
          "shared/sim/nbio/**",

          "!maddox/**",
          "!sloc/**",
          "!setup/**",
          "!fuzzstall/**",
          "!harness/**"
  ]
}

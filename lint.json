{
  "shared_component": "shared",
  "instrumentation_packages": [
          "shared/std/sim/aver/**",
          "shared/std/snap/**",
          "shared/std/jlog/**"
  ],
  "pure_but_indeterministic_packages": [
    "lint/internal/",
    "sloc/internal/**",
    "shared/std/sync/diode/",
    "shared/std/sim/aver/",
    "shared/std/jlog/",
    "shared/std/snap/"
  ],
  "ignore": [
          "install_golang.sh",
          "nix/**",
          "shared/std/sim/aver/enforcement_noop*",
          "build.go",
          "home/**",
          "documentation/youtube/**",
          "shared_lua/**",
          "shared/std/crypto/ecdsa/**",
          "shared/std/crypto/ed25519/**",
          "shared/std/crypto/elliptic/**",
          "shared/std/crypto/rsa/**",
          "shared/std/crypto/subtle/**",
          "shared/std/crypto/x509/**"
  ],
  "opt_out_interface_ban": [
          "lint/internal/",
          "shared/std/backoff/",
          "shared/std/crypto/prng/",
          "shared/std/encoding/binary/",
          "shared/std/encoding/flatjson/",
          "shared/std/jlog/",
          "shared/std/sim/aver/**",
          "shared/std/sim/nbio/",
          "shared/std/sim/time/",
          "shared/std/slices/",
          "shared/std/snap/**",
          "shared/std/sort/",
          "shared/std/testify/"
  ],
  "opt_out_recursion_ban": [
          "shared/std/text/glob/**",
          "shared/std/go/**"
  ],
  "opt_out_assertion_mandate_packages": [
          "**",
          "!shared/**",
          "shared/vsr/**",
          "shared/std/testify/**",
          "shared/std/sim/nbio/**",

          "!maddox/**",
          "!sloc/**",
          "!setup/**",
          "!fuzzstall/**",
          "!harness/**"
  ]
}

/target/
/rendered-docs
.direnv
.envrc
# Generated by nix build, nix-build
result
# Generated by the insta crate
*.pending-snap
*.snap*
!cli/tests/cli-reference@.md.snap
# Per user insta settings.
# See https://insta.rs/docs/settings/#tool-config-file for details.
.config/insta.yaml
# Per user mise config
mise.local.toml

# mkdocs
/.venv
/.python-version

# Editor specific ignores
.idea
.vscode
.zed

# Generated by setting `JJ_TRACE` environment variable.
jj-trace-*.json

# To make working on buck2 easier (#1997, #4413)
/buck-out/

# vendor/ is pinned third-party crate source, not jj's own tree. cargo's
# directory-source checksums verify every vendored file at build time, so files
# the dev-tree rules above strip (.envrc from ansi-to-tui, *.snap* from insta
# crates, ...) break the offline build. Keep the vendored copies tracked.
!vendor/**/.envrc
!vendor/**/*.snap*
!vendor/**/*.pending-snap
!vendor/**/.direnv
